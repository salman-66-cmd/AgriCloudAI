# ==============================================================================
# AgriCloud Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
# Default zero-config local development uses SQLite file database:
DATABASE_URL=file:./agricloud.db

# Production / Docker Compose PostgreSQL connection string:
# DATABASE_URL=postgresql://agricloud_user:agricloud_secure_pass@localhost:5432/agricloud_db?schema=public

# Authentication Secrets (Replace with high-entropy 256-bit keys in production)
JWT_ACCESS_SECRET=agricloud_access_secret_key_development_only_replace_in_prod_2026
JWT_REFRESH_SECRET=agricloud_refresh_secret_key_development_only_replace_in_prod_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# IoT Sensor Simulation Worker
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_SECONDS=10
SIMULATION_FAULT_CHANCE=0.02
SIMULATION_RAIN_CHANCE=0.08

# Irrigation Safety Thresholds
MAX_CONTINUOUS_IRRIGATION_SECONDS=1800
IRRIGATION_COOLDOWN_DEFAULT_MINUTES=60

# File Upload Storage (Local disk fallback)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880

# Logging & Monitoring
LOG_LEVEL=info
